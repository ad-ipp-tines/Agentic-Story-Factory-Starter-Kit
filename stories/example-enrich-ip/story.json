          "verdict": "=IF(LOCAL.score >= 70, \"malicious\", IF(LOCAL.score >= 30, \"suspicious\", \"clean\"))",
          "sources": ["virustotal", "abuseipdb"],
          "summary": "=CONCAT(normalize.ip, \" is \", IF(LOCAL.score >= 70, \"malicious\", IF(LOCAL.score >= 30, \"suspicious\", \"clean\")), \" (score \", LOCAL.score, \") per VirusTotal and AbuseIPDB.\")"
        }
