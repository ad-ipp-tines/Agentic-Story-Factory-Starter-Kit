      "guid": "00000000000000000000000000000012",
      "origin_story_identifier": "cloud:<tenant-guid>:<story-guid>",
      "options": {
        "mode": "message_only",
        "loop": false,
        "local": {
          "abuse_score": "=DEFAULT(lookup_abuseipdb.body.<abuse-confidence-path>, 0)",
          "vt_malicious": "=DEFAULT(lookup_virustotal.body.<malicious-count-path>, 0)",
          "score": "=MAX(LOCAL.abuse_score, LOCAL.vt_malicious * 10)"
        },
