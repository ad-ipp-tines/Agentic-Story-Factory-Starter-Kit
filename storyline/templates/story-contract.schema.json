{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tines-storyworks/storyline/templates/story-contract.schema.json",
  "title": "Story contract (the design contract block)",
  "description": "The one fenced, versioned JSON block in storyline/work/<slug>/design.md (fence info string `json story-contract`). Written by story-architect, validated by ./scripts/storyline apply and by the readiness gate G1 (./scripts/storyline ready, and storyline.yml on the design PR). Spec: REPO-DESIGN.md §4.4 (02 design). Names only: credentials, Resources and Records are referenced by name, never by value. Every enum that names a phase, status or gate comes from storyline/lifecycle/state-machine.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "story_key", "title", "summary", "tier", "mode", "acceptance_criteria", "entry",
    "actions_outline", "credentials", "resources", "records", "egress_hosts", "ai_agents", "tools_design",
    "access", "risk", "out_of_scope", "touch_set", "cost_estimate", "qa_guidance"
  ],
  "properties": {
    "contract_version": {
      "const": 1,
      "description": "Bumped only by a PR that changes this schema; the build handoff names it (\"contract v1\")"
    },
    "story_key": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$",
      "description": "The slug: the folder under stories/ and storyline/work/, and the tracker key"
    },
    "title": {
      "type": "string",
      "pattern": "^\\[[A-Z]{2,6}\\] [0-9]{2} · .{3,80}$",
      "description": "[PREFIX] NN · Verb noun — identical in every environment (import matches by name); a sub-story ends in (sub)"
    },
    "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
    "tier": { "type": "string", "enum": ["production", "internal", "ops", "seed"] },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rung", "value", "why_not_lower"],
      "properties": {
        "rung": {
          "type": "integer", "minimum": 1, "maximum": 5,
          "description": "The rung of docs/01-decision-rules.md: 1 HTTP Request or template · 2 Send to Story sub-story · 3 AI Agent action with Tines tools · 4 Mode 3 with an MCP connection · 5 Mode 4 MCP server action"
        },
        "value": {
          "type": "string",
          "enum": ["none", "sub-story", "mode-1-preset", "mode-3-agent", "mode-4-server"],
          "description": "The mode badge: which Mode the story exposes or uses (mode-1-preset = Mode 1, mode-3-agent = Mode 3, mode-4-server = Mode 4), sub-story, or none. Mode 2 is how every story is built, so it is never a badge"
        },
        "why_not_lower": {
          "type": "array",
          "items": { "type": "string", "minLength": 10, "maxLength": 300 },
          "description": "One sentence per lower rung saying why it cannot do the job; empty only at rung 1"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "rung": { "minimum": 2 } } },
          "then": { "properties": { "why_not_lower": { "minItems": 1 } } }
        }
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{1,3}$" },
          "given": { "type": "string", "minLength": 3, "maxLength": 400 },
          "when": { "type": "string", "minLength": 3, "maxLength": 400 },
          "then": { "type": "string", "minLength": 3, "maxLength": 400, "description": "Observable in a run's events, logs or result fields, so a case can check it" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {
        "type": { "type": "string", "enum": ["webhook", "send_to_story", "schedule", "page", "mcp_server"] },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "The entry action's name" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "required": { "type": "boolean" },
              "default": { "description": "The DEFAULT() fallback the normalize transform applies" },
              "description": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "schedule_interval_seconds": { "type": "integer", "minimum": 0, "description": "For type schedule; 0 otherwise" }
      }
    },
    "actions_outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "does"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "type": {
            "type": "string",
            "description": "The action type as the storyboard names it (Webhook, Event Transform, Trigger, HTTP Request, Send to Story, AI Agent, Records, Page, Email, MCP server, …)"
          },
          "does": { "type": "string", "minLength": 3, "maxLength": 300 },
          "on_failure": { "type": "string", "maxLength": 200, "description": "Where its failure path goes (normally the `error` Event Transform)" }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
      "uniqueItems": true,
      "description": "Credential NAMES; each must exist under the same name in every team the story is deployed to"
    },
    "resources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
      "uniqueItems": true,
      "description": "Resource NAMES read by the story"
    },
    "records": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
      "uniqueItems": true,
      "description": "Record type NAMES the story reads or writes"
    },
    "egress_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(<[a-z0-9-]+>|[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)$"
      },
      "uniqueItems": true,
      "description": "Every host the story calls, as a hostname or a <placeholder>; security-reviewer checks sec.3 and sec.4 against it. Never a tenant hostname: use <your-tenant>"
    },
    "ai_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "task_or_chat", "tools", "output_schema_ref", "model_tier", "skills", "budget_ref"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "task_or_chat": { "type": "string", "enum": ["task", "chat"] },
          "tools": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "description": "Tool names from tools_design; one first, at most five"
          },
          "output_schema_ref": { "type": "string", "minLength": 1, "description": "Path of the Output schema in the repo, or `inline` when it lives only on the action" },
          "model_tier": { "type": "string", "enum": ["fast", "smart"], "description": "The tenant default the action runs on, or the model pinned on it" },
          "model_pinned": { "type": "boolean", "description": "true when a model is chosen on the action (required for a fast-tier agent that carries a skill, cost.4)" },
          "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" } },
          "budget_ref": { "type": "string", "pattern": "^[a-z0-9-]{1,64}/[a-z0-9_]{1,64}$", "description": "The key under agents: in policies/cost-ceilings.yml (<slug>/<action name>)" },
          "trigger_after": { "type": "string", "description": "The schema field the Trigger after the agent branches on" }
        }
      }
    },
    "tools_design": {
      "type": "array",
      "description": "For Mode 3 and Mode 4 only; empty otherwise",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "args", "returns", "hints"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "description": { "type": "string", "minLength": 20, "maxLength": 1000, "description": "The API a model reads: what it does, what it returns (3–5 fields), what it never does, one example" },
          "args": { "type": "object", "description": "Argument name → one-line description" },
          "returns": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string" } },
          "hints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["read_only", "destructive", "idempotent", "open_world"],
            "properties": {
              "read_only": { "type": "boolean" },
              "destructive": { "type": "boolean" },
              "idempotent": { "type": "boolean" },
              "open_world": { "type": "boolean" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "name": { "pattern": "(block|delete|isolate|disable)" } } },
            "then": { "properties": { "name": { "pattern": "^request_" } } }
          },
          {
            "if": { "properties": { "hints": { "properties": { "destructive": { "const": true } } } } },
            "then": { "properties": { "name": { "pattern": "^request_" } } }
          }
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "webhook", "mcp_server"],
      "properties": {
        "page": {
          "type": "object", "additionalProperties": false, "required": ["level"],
          "properties": {
            "level": { "type": "string", "enum": ["none", "team_members", "via_sso", "anyone_with_link"] },
            "reason": { "type": "string", "maxLength": 300 }
          }
        },
        "webhook": {
          "type": "object", "additionalProperties": false, "required": ["level"],
          "properties": {
            "level": { "type": "string", "enum": ["none", "secret", "team", "tenant", "public"], "description": "The Webhook access control levels (Public, Secret, Team, Tenant), or none when the story has no Webhook" },
            "reason": { "type": "string", "maxLength": 300 }
          }
        },
        "mcp_server": {
          "type": "object", "additionalProperties": false, "required": ["level"],
          "properties": {
            "level": { "type": "string", "enum": ["none", "team", "tenant", "other"], "description": "The MCP server action's access setting (Mode 4); `other` needs a reason — the access-mode names are scaffold VERIFY #25" },
            "reason": { "type": "string", "maxLength": 300 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "page": { "properties": { "level": { "enum": ["via_sso", "anyone_with_link"] } } } } },
          "then": { "properties": { "page": { "required": ["level", "reason"] } } } },
        { "if": { "properties": { "webhook": { "properties": { "level": { "const": "public" } } } } },
          "then": { "properties": { "webhook": { "required": ["level", "reason"] } } } },
        { "if": { "properties": { "mcp_server": { "properties": { "level": { "enum": ["tenant", "other"] } } } } },
          "then": { "properties": { "mcp_server": { "required": ["level", "reason"] } } } }
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_effects", "shadow_mode", "data_sensitivity"],
      "properties": {
        "side_effects": { "type": "boolean", "description": "true when the story acts on a system outside its own Records and Resources; the story then starts in shadow (06 operate)" },
        "shadow_mode": { "type": "boolean", "description": "true when side-effecting actions sit behind a Trigger on the <slug>_rollout Resource" },
        "data_sensitivity": { "type": "string", "enum": ["none", "internal", "confidential", "regulated"] }
      },
      "allOf": [
        { "if": { "properties": { "side_effects": { "const": true } } },
          "then": { "properties": { "shadow_mode": { "const": true } } } }
      ]
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 300 }
    },
    "touch_set": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "The paths this story's work may change; must sit inside storyline/lifecycle/touch-sets.yaml for design and build"
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_per_day", "credits_per_run_est", "monthly_credits_est", "provider", "basis"],
      "properties": {
        "runs_per_day": { "type": "number", "minimum": 0 },
        "credits_per_run_est": { "type": "number", "minimum": 0, "description": "Tines AI credits per run (1 credit = $0.01); 0 without an AI Agent action" },
        "monthly_credits_est": { "type": "number", "minimum": 0 },
        "provider": { "type": "string", "enum": ["tines_provided", "custom", "local", "none"] },
        "basis": { "type": "string", "minLength": 3, "maxLength": 300, "description": "From ./scripts/storyline estimate: the comparables used, or \"no AI Agent action\"" }
      }
    },
    "qa_guidance": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1500,
      "description": "What story-qa and the human verifier should look at in Tines, beyond the cases"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "properties": { "value": { "enum": ["mode-3-agent", "mode-4-server"] } } } } },
      "then": { "properties": { "tools_design": { "minItems": 1 } } }
    }
  ]
}
