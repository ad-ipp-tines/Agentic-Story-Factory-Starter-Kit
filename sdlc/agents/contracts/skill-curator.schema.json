{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-story-factory/sdlc/agents/contracts/skill-curator.schema.json",
  "title": "skill-curator — input requirements and output payload",
  "description": "Spec: REPO-DESIGN.md §5.3.10, P24. Files: edits to tines-skills/** (Agent Skills frontmatter rules in .claude/rules/tines-skills.md), .claude/skills/tines-build-story/references/prompt-pack.md, or sdlc/field-guide.md (entries provenance-tagged, deduped, secret-free, within the line budget). Every change is validated on HELD-OUT cases: held_out_cases must not appear among evidence_refs, and a change to tines-skills/<name>/ needs sdlc/evals/skills/<name>.cases.yaml to exist (sdlc.yml fails the PR otherwise). A change backed by a single event is never proposed.",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "phase",
        "inputs"
      ],
      "properties": {
        "phase": {
          "const": "improve"
        },
        "inputs": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "retro"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "field_guide"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "agent_evals"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "summary",
              "evidence_refs",
              "held_out_cases"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(tines-skills/[a-z0-9-]{1,64}/SKILL\\.md|\\.claude/skills/tines-build-story/references/prompt-pack\\.md|sdlc/field-guide\\.md)$"
              },
              "summary": {
                "type": "string",
                "minLength": 10,
                "maxLength": 400
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 2,
                "description": "At least two independent occurrences (never a single event)",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                }
              },
              "held_out_cases": {
                "type": "array",
                "minItems": 1,
                "description": "Case ids from sdlc/evals/skills/<name>.cases.yaml or sdlc/evals/agents/*.cases.yaml that were NOT used to derive the change; sdlc-evals.yml runs them",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "description": "What ./scripts/sdlc apply validates the envelope's `payload` against: the full payload ($defs.payload) when the envelope verdict is done or changes_requested, or an empty object when it is needs_human or blocked (envelope.schema.json enforces which verdict allows which).",
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/payload"
        }
      ]
    }
  }
}
