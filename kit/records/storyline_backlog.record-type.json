{
  "name": "storyline_backlog",
  "team_id": 0,
  "max_records_limit": 1000,
  "on_limit_reached": "REJECT",
  "fields": [
    { "name": "story_key", "result_type": "TEXT" },
    { "name": "title", "result_type": "TEXT" },
    { "name": "use_case", "result_type": "ARTIFACT" },
    { "name": "library_seed_id", "result_type": "NUMBER" },
    { "name": "mode", "result_type": "TEXT_ENUM", "fixed_values": ["none", "sub-story", "mode-1-preset", "mode-3-agent", "mode-4-server"] },
    { "name": "owner", "result_type": "TEXT" },
    { "name": "tier", "result_type": "TEXT_ENUM", "fixed_values": ["production", "internal", "ops", "seed"] },
    { "name": "phase", "result_type": "TEXT_ENUM", "fixed_values": ["intake", "discover", "design", "build", "verify", "ship", "operate", "improve", "parked", "rejected", "retired"] },
    { "name": "status", "result_type": "TEXT_ENUM", "fixed_values": ["active", "awaiting_gate", "rework", "blocked", "shadow", "live"] },
    { "name": "open_gate", "result_type": "TEXT_ENUM", "fixed_values": ["none", "G0", "G1", "G2", "G3", "G4", "G5a", "G5b", "G6", "G7", "GB", "GX"] },
    { "name": "attempt", "result_type": "NUMBER" },
    { "name": "target_date", "result_type": "TIMESTAMP" },
    { "name": "credit_estimate_monthly", "result_type": "NUMBER" },
    { "name": "credit_estimate_basis", "result_type": "TEXT" },
    { "name": "provider", "result_type": "TEXT_ENUM", "fixed_values": ["tines_provided", "custom", "local", "none"] },
    { "name": "prod_story_id", "result_type": "NUMBER" },
    { "name": "live_since", "result_type": "TIMESTAMP" },
    { "name": "design_pr", "result_type": "TEXT" },
    { "name": "build_pr", "result_type": "TEXT" },
    { "name": "change_request_id", "result_type": "TEXT" },
    { "name": "rev", "result_type": "NUMBER" },
    { "name": "pending_repo_sync", "result_type": "BOOLEAN" },
    { "name": "pending_base_rev", "result_type": "NUMBER" },
    { "name": "outbox_seq", "result_type": "NUMBER" },
    { "name": "acked_seq", "result_type": "NUMBER" },
    { "name": "specialist_due", "result_type": "TEXT_ENUM", "fixed_values": ["none", "brief-writer", "planner", "retro-writer"] },
    { "name": "specialist_status", "result_type": "TEXT_ENUM", "fixed_values": ["idle", "pending", "running", "proposed", "accepted", "rejected", "failed"] },
    { "name": "proposal", "result_type": "JSON" },
    { "name": "brief", "result_type": "ARTIFACT" },
    { "name": "retro", "result_type": "ARTIFACT" },
    { "name": "last_actor", "result_type": "TEXT" },
    { "name": "last_transition_at", "result_type": "TIMESTAMP" }
  ]
}
