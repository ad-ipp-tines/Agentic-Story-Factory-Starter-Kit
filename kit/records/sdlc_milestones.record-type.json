{
  "name": "sdlc_milestones",
  "team_id": 0,
  "fields": [
    { "name": "milestone_id", "result_type": "TEXT_ENUM", "fixed_values": ["day-1", "week-1", "week-4"] },
    { "name": "title", "result_type": "TEXT" },
    { "name": "criteria", "result_type": "ARTIFACT" },
    { "name": "status", "result_type": "TEXT_ENUM", "fixed_values": ["not_started", "in_progress", "done", "blocked"] },
    { "name": "due_date", "result_type": "TIMESTAMP" },
    { "name": "evidence_ref", "result_type": "TEXT" },
    { "name": "owner", "result_type": "TEXT" },
    { "name": "rev", "result_type": "NUMBER" },
    { "name": "pending_repo_sync", "result_type": "BOOLEAN" }
  ]
}
