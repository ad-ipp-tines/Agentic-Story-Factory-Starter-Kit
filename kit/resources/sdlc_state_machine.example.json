    ]
  },
  "gate_decided_by": {
    "G0": "the story owner or an approver listed for G0",
    "G1": "./scripts/sdlc ready (and sdlc.yml on the design PR)",
    "G2": "a CODEOWNER of the story's prefix who is not the PR author",
    "G3": "the person driving the build session",
    "G4": "sdlc.yml (calls lint.yml and review.yml), verify-report.json, the human QA verification line, a CODEOWNER, and a human merge (never the author)",
    "G5a": "a required reviewer of the GitHub production environment, before ship.yml's mode: new import",
    "G5b": "the named approver in Tines (no approver key exists in CI)",
    "G6": "the owner and an approver listed for G6",
    "G7": "the owner and platform",
    "GB": "opened by ./scripts/sdlc ready (design), the sdlc_limits caps (Tines) or the ops sweep (operate); released by a human",
    "GX": "the owner"
  },
  "gate_decisions": {
    "G0": [
      "build",
      "reject",
      "park"
    ],
    "G1": [
      "pass",
      "fail"
    ],
    "G2": [
      "merged",
      "rethink_reuse"
    ],
    "G3": [
      "approve",
      "reject"
    ],
    "G4": [
      "merged",
      "changes_requested"
    ],
    "G5a": [
      "approved_and_imported",
      "rejected"
    ],
    "G5b": [
      "approved_and_pushed",
      "rejected"
    ],
    "G6": [
      "go_live",
      "stay_shadow"
    ],
    "G7": [
      "keep",
      "rescope",
      "retire"
    ],
    "GB": [
      "park",
      "unpark"
    ],
    "GX": [
      "resume",
      "park",
      "reject"
    ]
  },
  "gate_types": {
    "G0": "human",
    "G1": "deterministic",
    "G2": "human",
    "G3": "human",
    "G4": "layered",
    "G5a": "human",
    "G5b": "human",
    "G6": "human",
    "G7": "human",
    "GB": "budget",
    "GX": "human"
  },
  "gates": [
    "G0",
    "G1",
    "G2",
    "G3",
    "G4",
    "G5a",
    "G5b",
    "G6",
    "G7",
    "GB",
    "GX"
  ],
  "holding": [
    "parked"
  ],
  "open_gate_none": "none",
  "open_gate_values": [
    "none",
    "G0",
    "G1",
    "G2",
    "G3",
    "G4",
    "G5a",
    "G5b",
    "G6",
    "G7",
    "GB",
    "GX"
  ],
  "page_decision_table": {
    "G0:build": [
      {
        "from": "intake",
        "status": "active",
        "to": "discover"
      }
    ],
    "G0:park": [
      {
        "from": "intake",
        "status": "awaiting_gate",
        "to": "parked"
      }
    ],
    "G0:reject": [
      {
        "from": "intake",
        "status": "active",
        "to": "rejected"
      }
    ],
    "G6:go_live": [
      {
        "from": "operate",
        "status": "live",
        "to": "operate"
      }
    ],
    "G6:stay_shadow": [
      {
        "from": "operate",
        "status": "shadow",
        "to": "operate"
      }
    ],
    "G7:keep": [
      {
        "from": "operate",
        "status": "$same",
        "to": "operate"
      }
    ],
    "G7:rescope": [
      {
        "from": "operate",
        "reset_attempt": true,
        "status": "active",
        "to": "design"
      }
    ],
    "G7:retire": [
      {
        "from": "operate",
        "status": "active",
        "to": "retired"
      }
    ],
    "GX:park": [
      {
        "from": "*",
        "status": "awaiting_gate",
        "to": "parked"
      }
    ],
    "GX:reject": [
      {
        "from": "*",
        "status": "active",
        "to": "rejected"
      }
    ],
    "GX:resume": [
      {
        "from": "verify",
        "reset_attempt": true,
        "status": "rework",
        "to": "build",
        "when": "attempt >= rework_cap"
      },
      {
        "from": "*",
        "status": "$previous",
        "to": "$same"
      }
    ],
    "unpark": [
      {
        "from": "parked",
        "status": null,
        "to": "$previous"
      }
    ]
  },
  "page_gates": [
    "G0",
    "G6",
    "G7",
    "GX"
  ],
  "page_options": {
    "G0": [
      "build",
      "reject",
      "park"
    ],
    "G6": [
      "go_live",
      "stay_shadow"
    ],
    "G7": [
      "keep",
      "rescope",
      "retire"
    ],
    "GX": [
      "resume",
      "park",
      "reject"
    ],
    "unpark": [
      "unpark"
    ]
  },
  "phase_statuses": {
    "build": [
      "active",
      "rework",
      "blocked"
    ],
    "design": [
      "active",
      "blocked"
    ],
    "discover": [
      "active",
      "blocked"
    ],
    "improve": [
      "active",
      "blocked"
    ],
    "intake": [
      "active",
      "awaiting_gate",
      "blocked"
    ],
    "operate": [
      "shadow",
      "live",
      "blocked"
    ],
    "parked": [
      "awaiting_gate"
    ],
    "rejected": [
      "active"
    ],
    "retired": [
      "active"
    ],
    "ship": [
      "active",
      "awaiting_gate",
      "blocked"
    ],
    "verify": [
      "active",
      "blocked"
    ]
  },
  "phases": [
    "intake",
    "discover",
    "design",
    "build",
    "verify",
    "ship",
    "operate",
    "improve"
  ],
  "runtime_dispatch": {
    "on_backlog_change": {
      "agent": "planner",
      "debounce_minutes": 60
    },
    "on_enter": {
      "improve": "retro_writer",
      "intake": "brief_writer"
    },
    "on_schedule": {
      "planner": {
        "weekly_day": "MON"
      },
      "retro_writer": {
        "after_live_days": 7,
        "every_days": 30
      }
    }
  },
  "source": "sdlc/lifecycle/state-machine.yaml — generated by ./scripts/kit bundle and kept current by kit-sync.yml; never edit this Resource by hand",
  "statuses": [
    "active",
    "awaiting_gate",
    "rework",
    "blocked",
    "shadow",
    "live"
  ],
  "terminal": [
    "rejected",
    "retired"
  ],
  "thresholds": {
    "budget_park_pct": 100,
    "budget_warn_pct": 80,
    "credit_variance_improve": 1.5,
    "eval_k_default": 3,
    "summary_max_chars": 1500
  },
  "timers": {
    "gate_nudge_days": 3,
    "retro_after_live_days": 7,
    "retro_cadence_days": 30,
    "shadow_days": 7
  },
  "transitions": [
    {
      "check": "intake_complete",
      "from": "intake",
      "status": "awaiting_gate",
      "then": "G0",
      "to": "intake"
    },
    {
      "decision": "build",
      "from": "intake",
      "gate": "G0",
      "to": "discover"
    },
    {
      "decision": "reject",
      "from": "intake",
      "gate": "G0",
      "to": "rejected"
    },
    {
      "decision": "park",
      "from": "intake",
      "gate": "G0",
      "to": "parked"
    },
    {
      "check": "discovery_complete",
      "from": "discover",
      "to": "design"
    },
    {
      "from": "design",
      "gates": [
        "G1",
        "G2"
      ],
      "to": "build"
    },
    {
      "decision": "rethink_reuse",
      "from": "design",
      "gate": "G2",
      "to": "discover"
    },
    {
      "check": "build_evidence",
      "from": "build",
      "to": "verify"
    },
    {
      "decision": "changes_requested",
      "from": "verify",
      "gate": "G4",
      "status": "rework",
      "to": "build",
      "when": "attempt < rework_cap"
    },
    {
      "from": "verify",
      "gate": "GX",
      "status": "blocked",
      "to": "verify",
      "when": "attempt >= rework_cap"
    },
    {
      "decision": "merged",
      "from": "verify",
      "gate": "G4",
      "status": "awaiting_gate",
      "then": "G5a if manifest new: true else G5b",
      "to": "ship"
    },
    {
      "decision": "approved_and_imported",
      "from": "ship",
      "gate": "G5a",
      "status": "shadow if contract.risk.side_effects else live",
      "to": "operate",
      "when": "manifest new: true"
    },
    {
      "decision": "approved_and_pushed",
      "from": "ship",
      "gate": "G5b",
      "status": "shadow if contract.risk.side_effects else live",
      "to": "operate"
    },
    {
      "decision": "rejected",
      "from": "ship",
      "gate": "G5a",
      "status": "rework",
      "then": "revert_pr",
      "to": "build"
    },
    {
      "decision": "rejected",
      "from": "ship",
      "gate": "G5b",
      "status": "rework",
      "then": "revert_pr",
      "to": "build"
    },
    {
      "decision": "go_live",
      "from": "operate",
      "gate": "G6",
      "status": "live",
      "to": "operate"
    },
    {
      "decision": "stay_shadow",
      "from": "operate",
      "gate": "G6",
      "status": "shadow",
      "to": "operate"
    },
    {
      "check": "improve_trigger",
      "from": "operate",
      "to": "improve"
    },
    {
      "check": "change_needed",
      "from": "improve",
      "reset_attempt": true,
      "to": "design"
    },
    {
      "check": "retire_candidate",
      "from": "improve",
      "status": "$previous",
      "then": "G7",
      "to": "operate"
    },
    {
      "check": "retro_closed",
      "from": "improve",
      "status": "$previous",
      "to": "operate"
    },
    {
      "decision": "retire",
      "from": "operate",
      "gate": "G7",
      "to": "retired"
    },
    {
      "decision": "keep",
      "from": "operate",
      "gate": "G7",
      "status": "$same",
      "to": "operate"
    },
    {
      "decision": "rescope",
      "from": "operate",
      "gate": "G7",
      "reset_attempt": true,
      "to": "design"
    },
    {
      "decision": "resume",
      "from": "verify",
      "gate": "GX",
      "reset_attempt": true,
      "status": "rework",
      "to": "build",
      "when": "attempt >= rework_cap"
    },
    {
      "decision": "resume",
      "from": "*",
      "gate": "GX",
      "status": "$previous",
      "to": "$same"
    },
    {
      "decision": "park",
      "from": "*",
      "gate": "GX",
      "to": "parked"
    },
    {
      "decision": "reject",
      "from": "*",
      "gate": "GX",
      "to": "rejected"
    },
    {
      "from": "*",
      "gate": "GX",
      "status": "blocked",
      "to": "$same"
    },
    {
      "decision": "unpark",
      "from": "parked",
      "gate": "GB",
      "to": "$previous"
    },
    {
      "from": "*",
      "gate": "GB",
      "to": "parked"
    }
  ],
  "version": 1
}
