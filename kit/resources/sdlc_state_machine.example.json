  "caps": {
    "failed_corrections_cap": 2,
    "one_open_gate_per_story": true,
    "rework_cap": 3,
    "wip_limit_per_owner": 1
  },
  "enums": {
    "actor_kind": [
      "human",
      "agent",
      "ci",
      "story"
    ],
    "event_type": [
      "transition",
