# .env.example — variable NAMES only. Copy to .env (gitignored), fill values, then `source .env`.
# Every line is `export`ed, so `source .env` makes the values visible to ./scripts/tines (Python reads the process
# environment), to terraform, and to a `claude` or Cursor session started afterwards FROM THE SAME SHELL — which means
# to every command the model runs there. So the .env an editor session inherits holds only what a read-only session
# needs: the tenant, a VIEWER-role dev key (exports, runs, logs) and the non-secret names below. Keys that change the
# tenant (the dev Editor key) and secret URLs (OPS_ROUTER_URL) are NOT exported into that shell: inject them at call
# time from your OS keychain or a secrets-manager CLI, in a terminal of your own, for that one command — for example
#   TINES_API_KEY="$(<your keychain or secrets-manager lookup>)" ./scripts/tines import-draft <slug> --env dev
# or let CI run it (the Editor-role keys live in GitHub environment secrets). Never paste a value into a prompt.
# Never commit .env. The editor is denied Read(./.env) in .claude/settings.json; the skills ask you to source it.

export TINES_TENANT=<your-tenant>      # host prefix only (the part before .tines.com)
export TINES_API_KEY=                  # TEAM-scoped key, VIEWER role, for the dev team (export, runs, logs); never a personal key.
                                       # The dev Editor-role key is injected at call time (above) or lives in CI — never here
export TINES_TEAM_ID=                  # dev team id (must match stories/_manifest.yaml: environments.dev.team_id)
export TINES_ENV=dev                   # dev | prod ; scripts refuse prod outside CI unless TINES_ALLOW_PROD=1
export OPS_ROUTER_URL=                 # the ops-error-router webhook URL (carries a secret -> never the manifest). Leave it EMPTY
                                       # in the editor's shell; inject it at call time for a local /tines-ship, or let ship.yml set it
export OPS_EMAIL_DL=                   # ops distribution list address
export STORYLINE_ENFORCE=1                  # phase-gate.sh: /mcp opens only for tines-builder while the active story is in build on origin/main.
                                       # Set 0 only for a scratch story; the hook logs it and guard-mcp.sh still mirrors every call.
# The two tracker webhook URLs are deliberately NOT here: they carry secrets and live only in the GitHub environment
# `tracker`, and ./scripts/kit refuses to call them unless GITHUB_ACTIONS=true and GITHUB_REF=refs/heads/main.

# --- CI-only names, for reference. These are GitHub ENVIRONMENT secrets (production, prod-read, break-glass),
# --- never values in a local .env and never in this file (scripts/README.md "GitHub configuration checklist"):
#   TINES_API_KEY_PROD          team-scoped key (Editor role) in the prod team: import, version, recipients, change requests, promote APPROVED only
#                               (the break-glass environment holds its OWN value under this name: a key that can disable and bypass)
#   TINES_API_KEY_PROD_READ     team-scoped key (Viewer role) for drift.yml, in environment prod-read (read-only by role - VERIFY)
#   TINES_TEAM_ID_PROD          prod team id
#   TINES_ALLOW_PROD=1          set only by the workflows that run against prod
#   BREAK_GLASS=1               set only by rollback.yml's break-glass jobs
#   ANTHROPIC_API_KEY           ENVIRONMENT secret, never a repository secret (any workflow a PR edits can read those): in
#                               `review` for review.yml (claude-code-action) and in `storyline-evals-ide` for storyline-evals.yml's IDE job;
#                               propose-fix.yml (default branch only) is the one reader still taking it from the repository scope; no MCP, no tenant
#   OPS_TOOLS_API_KEY           a member's team-scoped key for the Mode 4 ops tools server, on that person's machine only: held in
#                               the OS keychain or a secrets-manager CLI and handed to the MCP client when it starts — never
#                               exported into a shell an editor inherits, never a literal value in a user-scope MCP config
#                               (how each client reads a secret at start-up is VERIFY)
